<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D89B14E5-2626-4137-8F3C-0223FD9F2086}</ProjectGuid>
    <MainSource>GuakeTests.dpr</MainSource>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Console</AppType>
    <FrameworkType>None</FrameworkType>
    <ProjectVersion>18.4</ProjectVersion>
    <DCC_Namespace>System;Winapi;System.Win;Xml;Data;Vcl;System;Winapi;System.Win;Xml;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\vendor\i18n\Packages;..\vendor\stacktrace\source;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>$(BDS)\source\DUnitX;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_ExeOutput>..\bin\tests</DCC_ExeOutput>
    <DCC_DcuOutput>..\.build\tests\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_Optimize>false</DCC_Optimize>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_MajorVer>1</VerInfo_MajorVer>
    <VerInfo_MinorVer>0</VerInfo_MinorVer>
    <VerInfo_Release>1</VerInfo_Release>
    <VerInfo_Build>9</VerInfo_Build>
    <VerInfo_Locale>1045</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=Mateusz Nabialczyk;FileDescription=Testy Guake dla Windows;FileVersion=1.0.1.9;InternalName=GuakeTests;OriginalFilename=GuakeTests.exe;ProductName=Guake dla Windows;ProductVersion=1.0.1.9</VerInfo_Keys>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_MapFile>3</DCC_MapFile>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Guake.Core.Tests.pas" />
    <DCCReference Include="..\Src\Guake.Settings.pas" />
    <DCCReference Include="..\Src\Guake.Shells.pas" />
    <DCCReference Include="..\Src\Common\VersionU.pas" />
    <BuildConfiguration Include="Debug">
      <Key>Debug</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <DCCReference Include="Guake.Services.Tests.pas" />
    <DCCReference Include="..\Src\Guake.Localization.pas" />
    <DCCReference Include="..\Src\Guake.Logging.pas" />
    <DCCReference Include="..\vendor\stacktrace\source\StackTrace.pas" />
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>