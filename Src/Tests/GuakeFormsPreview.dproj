<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{972ACB47-F770-4B97-884F-699B771B5F19}</ProjectGuid>
    <MainSource>GuakeFormsPreview.dpr</MainSource>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>18.4</ProjectVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_Namespace>System;Winapi;System.Win;Xml;Data;Vcl;System;Winapi;System.Win;Xml;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\Vendor\i18n\Packages;..\Vendor\stacktrace\source;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>$(BDS)\source\DUnitX;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_ExeOutput>..\..\bin\forms</DCC_ExeOutput>
    <DCC_DcuOutput>..\..\.build\forms\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_Optimize>false</DCC_Optimize>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_MajorVer>1</VerInfo_MajorVer>
    <VerInfo_MinorVer>0</VerInfo_MinorVer>
    <VerInfo_Release>8</VerInfo_Release>
    <VerInfo_Build>43</VerInfo_Build>
    <VerInfo_Locale>1045</VerInfo_Locale>
    <VerInfo_Keys>CompanyName=Mateusz Nabialczyk;FileDescription=Formularze Guake dla Windows;FileVersion=1.0.8.43;InternalName=GuakeFormsPreview;OriginalFilename=GuakeFormsPreview.exe;ProductName=Guake dla Windows;ProductVersion=1.0.8.43</VerInfo_Keys>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_MapFile>3</DCC_MapFile>
    <PostBuildEvent>python "$(MSBuildProjectDirectory)\..\Tools\Build-Symbols.py" "$(DCC_ExeOutput)\$(MSBuildProjectName).map"</PostBuildEvent>
    <PostBuildEventIgnoreExitCode>false</PostBuildEventIgnoreExitCode>
    <DCC_ResourcePath>..\Resources;$(BDS)\lib\win64\release;$(DCC_ResourcePath)</DCC_ResourcePath>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <Icon_MainIcon>..\Resources\Pixmaps\guake.ico</Icon_MainIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_Optimize>true</DCC_Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Optimize>false</DCC_Optimize>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="..\Settings\Guake.Settings.pas" />
    <DCCReference Include="..\Terminal\Guake.Shells.pas" />
    <DCCReference Include="..\Common\VersionU.pas" />
    <DCCReference Include="..\Localization\Guake.Localization.pas" />
    <DCCReference Include="..\Diagnostics\Guake.Logging.pas" />
    <DCCReference Include="..\Vendor\stacktrace\source\StackTrace.pas" />
    <DCCReference Include="..\Appearance\Guake.Palettes.pas" />
    <DCCReference Include="..\Forms\frmPreferencesU.pas">
      <Form>frmPreferences</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Forms\frmAboutU.pas">
      <Form>frmAbout</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Forms\frmSearchU.pas">
      <Form>frmSearch</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Forms\frmRenameU.pas">
      <Form>frmRename</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Forms\frmConfirmU.pas">
      <Form>frmConfirm</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Forms\frmMainU.pas">
      <Form>frmMain</Form>
      <FormType>dfm</FormType>
      <DesignClass>TForm</DesignClass>
    </DCCReference>
    <DCCReference Include="..\DataModules\dmDialogsU.pas">
      <Form>dmDialogs</Form>
      <FormType>dfm</FormType>
      <DesignClass>TDataModule</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Terminal\Guake.ConPTY.pas" />
    <DCCReference Include="..\Terminal\Guake.VT.pas" />
    <DCCReference Include="..\Terminal\Guake.Sessions.pas" />
    <DCCReference Include="..\Terminal\Guake.Keybindings.pas" />
    <DCCReference Include="..\Frames\fraTerminalU.pas">
      <Form>fraTerminal</Form>
      <FormType>dfm</FormType>
      <DesignClass>TFrame</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Frames\fraSplitU.pas">
      <Form>fraSplit</Form>
      <FormType>dfm</FormType>
      <DesignClass>TFrame</DesignClass>
    </DCCReference>
    <DCCReference Include="..\Resources\Guake.Resources.pas" />
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
  <PropertyGroup>
    <ResourceBuildDependsOn>BuildGuakeImages;$(ResourceBuildDependsOn)</ResourceBuildDependsOn>
  </PropertyGroup>
  <Target Name="BuildGuakeImages">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Tools\Build-Resources.ps1&quot;" />
  </Target>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">GuakeFormsPreview.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win64">True</Platform>
        <Platform value="Win32">False</Platform>
      </Platforms>
    </BorlandProject>
    <Borland.ProjectType />
  </ProjectExtensions>
</Project>